# Скопируйте в .env и заполните своими значениями
TELEGRAM_TOKEN=токен_от_BotFather
ANTHROPIC_API_KEY=ваш_ключ_anthropic
MODEL=claude-sonnet-4-6
# Понадобится позже, для реальной интеграции с Директом:
YANDEX_DIRECT_TOKEN=

# --- Кэш метрик в SQLite (по умолчанию выключен) ---
# USE_CACHE=true включает чтение из локальной базы + фоновую синхронизацию.
USE_CACHE=false
DB_PATH=metrics.sqlite3
SYNC_DAYS=30
SYNC_INTERVAL_MINUTES=60
